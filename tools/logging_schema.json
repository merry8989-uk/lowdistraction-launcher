{
  "schema_version": "2.0.0",
  "title": "Low Distraction — diagnostics event schema",
  "description": "One structured schema for every event the launcher records, in the nested shape the unified diagnostics plan asks for (source / severity / category / context / correlation / error / metrics / privacy), which follows the OpenTelemetry logs data model. Version 2.0.0 is a breaking change: the flat envelope became nested, log_level became an uppercase severity, and event_id and observed_timestamp were added. Bump the version on any further breaking change.",
  "envelope": {
    "required": [
      "schema_version",
      "event_id",
      "timestamp",
      "observed_timestamp",
      "source",
      "severity",
      "category",
      "event_name"
    ],
    "recommended": [
      "message",
      "context",
      "correlation",
      "privacy"
    ],
    "conditional": [
      "error",
      "metrics",
      "attributes"
    ],
    "omitted": {
      "request_id": "There are no requests to correlate: the app makes no network calls. correlation.attempt_id links one user action to its outcome instead.",
      "trace_id": "One process on one device, with no distributed tracing to join.",
      "user_id": "Omitted: the app has no accounts and no identifiers, so there is nothing to hash. A local analytics view needs no user id to count sessions."
    }
  },
  "enums": {
    "log_level": [
      "TRACE",
      "DEBUG",
      "INFO",
      "WARN",
      "ERROR",
      "FATAL"
    ],
    "platform": [
      "android"
    ],
    "release_channel": [
      "production",
      "beta"
    ],
    "network_type": [
      "wifi",
      "cellular",
      "offline"
    ],
    "start_type": [
      "cold",
      "warm"
    ],
    "permission_state": [
      "granted",
      "partial",
      "denied",
      "permanently_denied",
      "not_applicable"
    ],
    "outcome": [
      "success",
      "no_op",
      "failed",
      "cancelled"
    ],
    "launch_source": [
      "list",
      "pinned",
      "wheel",
      "search",
      "hidden"
    ],
    "export_format": [
      "txt",
      "md",
      "json",
      "csv",
      "zip",
      "all"
    ],
    "export_channel": [
      "save",
      "share",
      "email"
    ],
    "diagnostics_action": [
      "export",
      "share",
      "email",
      "clean",
      "toggle",
      "refresh"
    ],
    "search_source": [
      "apps",
      "settings",
      "contacts",
      "calendar",
      "files",
      "devcheck"
    ],
    "tea_action": [
      "start",
      "end",
      "ended_early"
    ],
    "category": [
      "application",
      "activity",
      "error",
      "security",
      "performance",
      "audit",
      "background",
      "debug"
    ]
  },
  "events": {
    "session_start": {
      "level": "INFO",
      "when": "App cold or warm start",
      "required": [
        "start_type"
      ],
      "optional": [
        "cold_start_ms",
        "warm_start_ms"
      ],
      "category": "application",
      "groups": {
        "context": [
          "start_type"
        ],
        "metrics": [
          "cold_start_ms",
          "warm_start_ms"
        ]
      }
    },
    "drop_off": {
      "level": "INFO",
      "when": "The last event before the app leaves the foreground",
      "required": [
        "last_screen",
        "last_event"
      ],
      "optional": [
        "duration_ms"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "last_screen",
          "last_event"
        ],
        "metrics": [
          "duration_ms"
        ]
      }
    },
    "screen_view": {
      "level": "INFO",
      "when": "A screen is shown",
      "required": [
        "screen_name",
        "previous_screen"
      ],
      "optional": [
        "duration_ms"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "screen_name",
          "previous_screen"
        ],
        "metrics": [
          "duration_ms"
        ]
      }
    },
    "permission_state_resolved": {
      "level": "INFO",
      "when": "After checking whether a feature holds its permission",
      "required": [
        "permission",
        "state"
      ],
      "optional": [
        "item_count"
      ],
      "category": "security",
      "groups": {
        "context": [
          "permission",
          "state"
        ],
        "metrics": [
          "item_count"
        ]
      }
    },
    "access_fix_requested": {
      "level": "INFO",
      "when": "The user asks for a permission to be fixed or granted",
      "required": [
        "permission",
        "state_before",
        "attempt_id"
      ],
      "optional": [
        "action_taken"
      ],
      "category": "security",
      "groups": {
        "context": [
          "permission",
          "state_before",
          "action_taken"
        ],
        "correlation": [
          "attempt_id"
        ]
      }
    },
    "access_fix_result": {
      "level": "INFO",
      "when": "The fix attempt finishes — the outcome half of the pair above",
      "required": [
        "attempt_id",
        "outcome"
      ],
      "optional": [
        "action_taken",
        "state_after",
        "error_code"
      ],
      "category": "security",
      "groups": {
        "correlation": [
          "attempt_id"
        ],
        "context": [
          "outcome",
          "action_taken",
          "state_after"
        ],
        "error": [
          "error_code"
        ]
      }
    },
    "media_query_result": {
      "level": "INFO",
      "when": "After walking storage for a file search",
      "required": [
        "source",
        "item_count",
        "query_ms"
      ],
      "optional": [
        "folders_visible"
      ],
      "category": "performance",
      "groups": {
        "context": [
          "source"
        ],
        "metrics": [
          "item_count",
          "query_ms",
          "folders_visible"
        ]
      }
    },
    "app_list_loaded": {
      "level": "INFO",
      "when": "The home list has been built",
      "required": [
        "item_count",
        "query_ms"
      ],
      "optional": [
        "hidden_count",
        "sort_mode"
      ],
      "category": "performance",
      "groups": {
        "metrics": [
          "item_count",
          "query_ms",
          "hidden_count"
        ],
        "context": [
          "sort_mode"
        ]
      }
    },
    "app_launch_requested": {
      "level": "INFO",
      "when": "The user taps an app — the intent half of the launch pair",
      "required": [
        "package",
        "source"
      ],
      "optional": [
        "pause_enabled",
        "attempt_id"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "package",
          "source",
          "pause_enabled"
        ],
        "correlation": [
          "attempt_id"
        ]
      }
    },
    "app_launch_result": {
      "level": "INFO",
      "when": "The launch finishes: opened, cancelled at the pause, or failed",
      "required": [
        "package",
        "outcome"
      ],
      "optional": [
        "attempt_id",
        "waited_ms"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "package",
          "outcome"
        ],
        "correlation": [
          "attempt_id"
        ],
        "metrics": [
          "waited_ms"
        ]
      }
    },
    "search_performed": {
      "level": "INFO",
      "when": "A search runs. The query itself is never recorded",
      "required": [
        "query_length",
        "result_count",
        "source"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "context": [
          "query_length",
          "result_count",
          "source"
        ]
      }
    },
    "search_no_results": {
      "level": "INFO",
      "when": "A search returns nothing",
      "required": [
        "query_length",
        "source"
      ],
      "optional": [
        "filters"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "query_length",
          "source"
        ]
      }
    },
    "settings_changed": {
      "level": "INFO",
      "when": "The user changes a setting",
      "required": [
        "setting"
      ],
      "optional": [
        "value"
      ],
      "category": "audit",
      "groups": {
        "context": [
          "setting",
          "value"
        ]
      }
    },
    "diagnostics_action": {
      "level": "INFO",
      "when": "The diagnostics screen is used",
      "required": [
        "action"
      ],
      "optional": [
        "format",
        "channel",
        "bytes",
        "entries",
        "value"
      ],
      "category": "audit",
      "groups": {
        "context": [
          "action",
          "format",
          "channel",
          "value"
        ],
        "metrics": [
          "bytes",
          "entries"
        ]
      }
    },
    "bubble_toggled": {
      "level": "INFO",
      "when": "The assistive bubble is switched on or off",
      "required": [
        "enabled"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "context": [
          "enabled"
        ]
      }
    },
    "guide_step": {
      "level": "INFO",
      "when": "A step of the first-run guide is shown",
      "required": [
        "step",
        "total"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "context": [
          "step",
          "total"
        ]
      }
    },
    "guide_finished": {
      "level": "INFO",
      "when": "The guide is completed or skipped",
      "required": [
        "steps_seen"
      ],
      "optional": [
        "skipped"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "steps_seen",
          "skipped"
        ]
      }
    },
    "tea_mode": {
      "level": "INFO",
      "when": "The five-minute break starts or ends",
      "required": [
        "action"
      ],
      "optional": [
        "duration_ms"
      ],
      "category": "activity",
      "groups": {
        "context": [
          "action"
        ],
        "metrics": [
          "duration_ms"
        ]
      }
    },
    "performance_marker": {
      "level": "INFO",
      "when": "A key flow completes",
      "required": [
        "flow",
        "duration_ms"
      ],
      "optional": [
        "frame_drops"
      ],
      "category": "performance",
      "groups": {
        "context": [
          "flow"
        ],
        "metrics": [
          "duration_ms"
        ]
      }
    },
    "error_state_shown": {
      "level": "WARN",
      "when": "An error message is put in front of the user",
      "required": [
        "error_code",
        "screen"
      ],
      "optional": [
        "message_key"
      ],
      "category": "error",
      "groups": {
        "error": [
          "error_code"
        ],
        "context": [
          "screen",
          "message_key"
        ]
      }
    },
    "crash": {
      "level": "FATAL",
      "when": "The process is about to die from an uncaught exception",
      "required": [
        "exception_type"
      ],
      "optional": [
        "stack_trace_hash",
        "stack_trace",
        "last_screen",
        "last_action",
        "thread",
        "main_thread",
        "uptime_ms"
      ],
      "category": "error",
      "groups": {
        "error": [
          "exception_type",
          "stack_trace_hash",
          "stack_trace"
        ],
        "context": [
          "last_screen",
          "last_action",
          "thread",
          "main_thread"
        ],
        "metrics": [
          "uptime_ms"
        ]
      }
    },
    "anr": {
      "level": "WARN",
      "when": "The main thread was blocked long enough to be felt",
      "required": [
        "duration_ms"
      ],
      "optional": [
        "last_screen"
      ],
      "category": "error",
      "groups": {
        "metrics": [
          "duration_ms"
        ],
        "context": [
          "last_screen"
        ]
      }
    },
    "rage_tap": {
      "level": "WARN",
      "when": "Three or more taps on the same thing inside two seconds",
      "required": [
        "target",
        "taps",
        "window_ms"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "context": [
          "target"
        ],
        "metrics": [
          "taps",
          "window_ms"
        ]
      }
    },
    "dead_click": {
      "level": "INFO",
      "when": "A tap that changed nothing at all",
      "required": [
        "target"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "context": [
          "target"
        ]
      }
    },
    "permission_loop": {
      "level": "WARN",
      "when": "The same permission fix is asked for three times in one session",
      "required": [
        "permission",
        "attempts"
      ],
      "optional": [],
      "category": "security",
      "groups": {
        "context": [
          "permission"
        ],
        "metrics": [
          "attempts"
        ]
      }
    },
    "back_button_spam": {
      "level": "WARN",
      "when": "Three or more back presses inside two seconds",
      "required": [
        "presses",
        "window_ms"
      ],
      "optional": [
        "screen"
      ],
      "category": "activity",
      "groups": {
        "metrics": [
          "presses",
          "window_ms"
        ],
        "context": [
          "screen"
        ]
      }
    },
    "scroll_depth": {
      "level": "INFO",
      "when": "A scrollable list reaches a new depth",
      "required": [
        "percent",
        "screen"
      ],
      "optional": [],
      "category": "activity",
      "groups": {
        "metrics": [
          "percent"
        ],
        "context": [
          "screen"
        ]
      }
    },
    "time_to_first_value": {
      "level": "INFO",
      "when": "From session start to the first meaningful action",
      "required": [
        "flow",
        "duration_ms"
      ],
      "optional": [],
      "category": "performance",
      "groups": {
        "context": [
          "flow"
        ],
        "metrics": [
          "duration_ms"
        ]
      }
    },
    "file_index_rebuild": {
      "category": "background",
      "level": "INFO",
      "when": "The background walk of storage finishes (or fails)",
      "required": [
        "outcome"
      ],
      "optional": [
        "item_count",
        "duration_ms",
        "trigger"
      ],
      "groups": {
        "context": [
          "outcome",
          "trigger"
        ],
        "metrics": [
          "item_count",
          "duration_ms"
        ]
      }
    },
    "bubble_hidden": {
      "category": "debug",
      "level": "DEBUG",
      "when": "The bubble steps aside over a payment or government app",
      "required": [
        "reason"
      ],
      "optional": [],
      "groups": {
        "context": [
          "reason"
        ]
      }
    },
    "previous_run_crashed": {
      "category": "error",
      "level": "WARN",
      "when": "The previous run ended in a crash and the app has started again",
      "required": [
        "exception_type"
      ],
      "optional": [
        "last_screen",
        "occurred_at"
      ],
      "groups": {
        "error": [
          "exception_type"
        ],
        "context": [
          "last_screen",
          "occurred_at"
        ]
      }
    },
    "wheel_opened": {
      "category": "activity",
      "level": "INFO",
      "when": "The assistive wheel is opened",
      "required": [
        "app_count"
      ],
      "optional": [],
      "groups": {
        "metrics": [
          "app_count"
        ]
      }
    },
    "exception": {
      "category": "error",
      "level": "ERROR",
      "when": "An exception was caught and handled rather than crashing the app",
      "required": [
        "exception_type"
      ],
      "optional": [
        "error_code",
        "stack_trace_hash",
        "screen",
        "operation",
        "outcome"
      ],
      "groups": {
        "error": [
          "exception_type",
          "error_code",
          "stack_trace_hash"
        ],
        "context": [
          "screen",
          "operation",
          "outcome"
        ]
      }
    }
  },
  "not_applicable": {
    "api_request": "The app has no INTERNET permission, so it makes no network calls and can never log one.",
    "page_view": "Web-only event.",
    "web_vitals": "Web-only event.",
    "js_error": "Web-only event.",
    "form_start": "Web-only event.",
    "form_abandon": "Web-only event.",
    "form_submit": "Web-only event.",
    "conversion": "Web-only event.",
    "feedback_submitted": "Web-only event.",
    "session_replay_marker": "No session replay is recorded anywhere in the app.",
    "user_id": "No accounts, so no identifier — not even a hashed one.",
    "database": "No database. Nothing is stored beyond SharedPreferences and one log file.",
    "database_logs": "No database to log against.",
    "server": "There is no server. The app is the whole product.",
    "infrastructure": "No servers, no deployment, no services to monitor.",
    "distributed_tracing": "One process on one device; there is no request to trace across services.",
    "login": "No accounts and no sign-in, so there are no login attempts to log.",
    "analytics": "No analytics SDK, no telemetry and no upload — the app has no internet permission. What there is instead is a local view over this log: the report's 'Usage (local analytics)' section counts sessions, screens, searches and feature adoption from the events already recorded."
  },
  "privacy": {
    "never_logged": [
      "email addresses",
      "phone numbers",
      "names",
      "exact location",
      "raw file paths",
      "media file names",
      "raw search queries",
      "auth tokens",
      "any identifier of a person"
    ],
    "logged_on_purpose": {
      "package": "The package name of an app the user opened (e.g. com.example.app). It is a public product identifier, not personal data, and a launch problem cannot be debugged without it. The user-visible label is never recorded."
    },
    "redaction": [
      "anything shaped like an email becomes [email]",
      "long digit runs become [number]",
      "absolute filesystem paths become [path]",
      "values are capped at 240 characters"
    ],
    "retention_days": 14,
    "size_cap_bytes": 524288,
    "opt_out": "Settings → Record diagnostics (on by default). While it is off nothing at all is written.",
    "transport": "There is no transport. The app cannot reach the network; a report leaves the phone only when the user exports, shares or mails it."
  }
}
